{
  "name": "fastify-ep",
  "version": "0.6.1",
  "description": "Scaffolds and keeps scaffolding a domain-driven module structure on native Fastify, without a DI runtime.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oluyoung/fastify-ep.git"
  },
  "homepage": "https://github.com/oluyoung/fastify-ep#readme",
  "bugs": {
    "url": "https://github.com/oluyoung/fastify-ep/issues"
  },
  "bin": {
    "fastify-ep": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "template-overlays",
    "module-template",
    "module-template-awilix",
    "resource-template",
    "resource-template-awilix",
    "resource-template-crud",
    "resource-template-crud-awilix",
    "resource-template-crud-drizzle",
    "resource-template-crud-orm",
    "resource-template-crud-prisma"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "examples": "node scripts/build-examples.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "license": "ISC"
}
