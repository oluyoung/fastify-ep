{
  "name": "fastify-ep",
  "version": "0.13.1",
  "description": "Scaffolds and keeps scaffolding a domain-driven module structure on native Fastify, without a DI runtime.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oluyoung/fastify-ep.git"
  },
  "homepage": "https://github.com/oluyoung/fastify-ep#readme",
  "bugs": {
    "url": "https://github.com/oluyoung/fastify-ep/issues"
  },
  "bin": {
    "fastify-ep": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "templates",
    "template-overlays",
    "library-template",
    "module-template",
    "module-template-awilix",
    "resource-template",
    "resource-template-awilix",
    "resource-template-crud",
    "resource-template-crud-awilix",
    "resource-template-crud-drizzle",
    "resource-template-crud-orm",
    "resource-template-crud-prisma",
    "component-template-service",
    "component-template-schema",
    "component-template-repository-drizzle",
    "component-template-repository-prisma"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "examples": "node scripts/build-examples.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/validate-npm-package-name": "^4.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "license": "ISC"
}
